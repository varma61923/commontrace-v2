{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commontrace.dev/schemas/memory-record.schema.json",
  "title": "CommonTrace versioned memory envelope",
  "description": "Optional additive envelope around existing memory payloads. No change to Trace or Lesson wire formats.",
  "type": "object",
  "required": ["id", "kind", "version", "payload", "status", "is_latest", "relations", "provenance", "scope", "confidence", "evidence"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["episode", "fact", "entity", "observation", "profile", "lesson", "directive"]},
    "version": {"type": "integer", "minimum": 1},
    "payload": {"type": "object"},
    "status": {"type": "string", "minLength": 1},
    "is_latest": {"type": "boolean"},
    "relations": {
      "type": "object",
      "propertyNames": {"enum": ["updates", "extends", "derives", "supersedes", "caused_by"]},
      "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}
    },
    "provenance": {"type": "object"},
    "scope": {
      "type": "object",
      "properties": {
        "tenant": {"type": "string"}, "user": {"type": "string"},
        "agent": {"type": "string"}, "session": {"type": "string"},
        "repo": {"type": "string"},
        "labels": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "valid_from": {"type": ["string", "null"]},
    "valid_until": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "retracted_at": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
