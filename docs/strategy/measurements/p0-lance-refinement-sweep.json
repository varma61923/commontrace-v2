{
  "scope": "Query-only tuning on one retained synthetic vector index; not full hybrid",
  "n": 1000000,
  "queries_per_round": 20,
  "rounds": 3,
  "baseline_sha256": "6f5b41ab00a64de4564b736124f8a86a37830e56865c2b9a773bceaba31ff9f3",
  "diagnostic_source": "\"\"\"Private query-only diagnostic: never mutates the retained benchmark index.\"\"\"\nimport argparse\nimport asyncio\nimport hashlib\nimport json\nimport statistics\nimport time\n\nimport numpy as np\nfrom benchmarks import vector_scale_bench as bench\nfrom commontrace.vector_lance import LanceVectorIndex\n\nasync def run(baseline):\n    root = baseline['retained_benchmark_store']\n    index = LanceVectorIndex(root, tenant=bench.TENANT, namespace=bench.NAMESPACE,\n                             model=bench.MODEL, dimension=baseline['dim'])\n    rng = np.random.default_rng(baseline['seed'])\n    centres = rng.normal(size=(baseline['clusters'], baseline['dim'])).astype(np.float32)\n    centres /= np.linalg.norm(centres, axis=1, keepdims=True)\n    block = bench._vectors(rng, centres, baseline['batch'], baseline['spread'])\n    noise = np.random.default_rng(baseline['seed'] + 1)\n    probes = []\n    for point in block[:40]:\n        query = point + noise.normal(0, baseline['spread'] / 2, size=baseline['dim']).astype(np.float32)\n        probes.append((query / np.linalg.norm(query)).tolist())\n    top_k = baseline['top_k']\n    def query_rows(query, config, exact=False):\n        search = index._table.search(query).distance_type('cosine').limit(top_k)\n        if exact:\n            search = search.bypass_vector_index()\n        else:\n            if 'refine_factor' in config: search = search.refine_factor(config['refine_factor'])\n            if 'ef' in config: search = search.ef(config['ef'])\n        return search.to_list()\n    try:\n        truths = []\n        for query in probes:\n            rows = await index._run(lambda: query_rows(query, {}, True))\n            truths.append({row['key'] for row in rows})\n        configurations = [{}, {'ef': 100}, {'refine_factor': 2}, {'refine_factor': 4},\n                          {'refine_factor': 8}, {'refine_factor': 2, 'ef': 100},\n                          {'refine_factor': 4, 'ef': 100}, {'refine_factor': 8, 'ef': 100}]\n        reports = [{'configuration': config, 'rounds': []} for config in configurations]\n        for report in reports:\n            for query in probes[:5]:\n                await index._run(lambda: query_rows(query, report['configuration']))\n        order_rng = np.random.default_rng(61923)\n        for round_number in range(3):\n            for config_index in order_rng.permutation(len(reports)):\n                report = reports[config_index]\n                times, recalls = [], []\n                for query, truth in zip(probes[:20], truths[:20]):\n                    started = time.perf_counter()\n                    rows = await index._run(lambda: query_rows(query, report['configuration']))\n                    times.append((time.perf_counter() - started) * 1000)\n                    recalls.append(len(truth & {r['key'] for r in rows}) / len(truth))\n                report['rounds'].append({'samples_ms': times, 'recalls': recalls,\n                                        'p95_ms': bench._percentile(times, .95),\n                                        'recall_at_k': statistics.mean(recalls), 'recall_min': min(recalls)})\n                print(json.dumps({'round': round_number, 'configuration': report['configuration'],\n                                  'p95_ms': report['rounds'][-1]['p95_ms'],\n                                  'recall_at_k': report['rounds'][-1]['recall_at_k']}), flush=True)\n        return {'scope': 'Query-only tuning on one retained synthetic vector index; not full hybrid',\n                'n': baseline['n'], 'queries_per_round': 20, 'rounds': 3,\n                'baseline_sha256': hashlib.sha256(open(args.baseline, 'rb').read()).hexdigest(),\n                'diagnostic_source': open(__file__).read(),\n                'probes': probes, 'truths': [sorted(t) for t in truths], 'sweep': reports}\n    finally:\n        await index.close()\n\np = argparse.ArgumentParser()\np.add_argument('baseline'); p.add_argument('out')\nargs = p.parse_args()\nresult = asyncio.run(run(json.load(open(args.baseline))))\nwith open(args.out, 'w') as output: json.dump(result, output, indent=2)\n",
