{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniMem runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "enum": [
        "local",
        "team",
        "server"
      ]
    },
    "host": {
      "type": "string",
      "maxLength": 253
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "agents": {
      "type": "object"
    },
    "histories": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "path"
        ],
        "properties": {
          "agent": {
            "enum": [
              "claude",
              "codex",
              "cursor",
              "gemini"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "model_routes": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "llm_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local": {
          "$ref": "#/$defs/profile"
        },
        "team": {
          "$ref": "#/$defs/profile"
        },
        "server": {
          "$ref": "#/$defs/profile"
        }
      }
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "secrets": {
      "$ref": "#/$defs/secret_references"
    }
  },
  "x-legacy-environment-aliases": {
