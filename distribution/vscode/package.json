{
  "name": "unimem", "displayName": "UniMem", "publisher": "unimem",
  "description": "Workspace memory and source-linked recall over native MCP.",
  "version": "1.0.0", "license": "AGPL-3.0-only", "engines": {"vscode": "^1.102.0"},
  "categories": ["AI", "Other"], "main": "./extension.js",
  "repository": {"type": "git", "url": "https://github.com/varma61923/commontrace-v2"},
  "capabilities": {"untrustedWorkspaces": {"supported": false}},
  "activationEvents": ["onMcpServerDefinitionProvider:unimem"],
  "contributes": {
    "commands": [
      {"command": "unimem.initialize", "title": "UniMem: Initialize Workspace Store"},
      {"command": "unimem.doctor", "title": "UniMem: Check Store Health"},
      {"command": "unimem.copyConfig", "title": "UniMem: Copy MCP Configuration"}
    ],
    "mcpServerDefinitionProviders": [{"id": "unimem", "label": "UniMem Workspace Memory"}],
    "configuration": {"title": "UniMem", "properties": {
      "unimem.command": {"type": "string", "default": "unimem", "scope": "resource", "restricted": true,
        "description": "Installed UniMem executable path, without shell arguments."},
      "unimem.approvalTools": {"type": "boolean", "default": false, "scope": "resource", "restricted": true,
        "description": "Expose lesson approval tools to the assistant."}
    }}
  },
  "scripts": {"test": "node --test", "lint": "node --check extension.js"}
}
