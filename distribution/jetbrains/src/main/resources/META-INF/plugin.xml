<idea-plugin>
  <id>io.commontrace.memory</id>
  <name>CommonTrace</name>
  <vendor url="https://github.com/varma61923/commontrace-v2">CommonTrace</vendor>
  <description>Initialize workspace memory, check store health, and copy native MCP configuration for AI Assistant.</description>
  <depends>com.intellij.modules.platform</depends>
  <actions>
    <action id="CommonTrace.Initialize" class="io.commontrace.StoreAction" text="CommonTrace: Initialize Store">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="CommonTrace.Doctor" class="io.commontrace.StoreAction" text="CommonTrace: Check Store Health">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="CommonTrace.CopyConfig" class="io.commontrace.StoreAction" text="CommonTrace: Copy MCP Configuration">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
