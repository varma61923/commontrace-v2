digraph agent_orchestrateur {
  rankdir=LR;
  bgcolor="white";
  fontname="DejaVu Sans";
  labelloc="t";
  fontsize=14;
  label=<<b>Orchestrateur (Claude principal)</b>  ·  présent sur toutes les phases (0 → 11)<br/><font point-size="10">Coordonne le pipeline, spawn les 5 sous-agents (background), tranche les verdicts, écrit la mémoire validée</font>>;
  nodesep=0.32;
  ranksep=0.65;

  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", penwidth=1.2, margin="0.12,0.07"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b", penwidth=1.1];

  // input
  user [label="Utilisateur\n/justdoit <tâche>", shape=oval, fillcolor="#0f172a", fontcolor="white"];

  // hub
  orch [label=<<b>ORCHESTRATEUR</b><br/><font point-size="9">P1 parser + brief A · P2 TaskCreate<br/>P4 commit après A · P6 décision verdict<br/>P7 itération · P8 arbitrage (it≥max)<br/>P9 rétro · P11 applique les ACCEPTÉ</font>>,
        fillcolor="#475569", fontcolor="white", penwidth=1.7];

  // sous-agents spawnés (couleur = agent)
  subgraph cluster_spawn {
    label=<<b>Spawn frais (Agent, run_in_background)</b>>; fontsize=10; style="rounded"; color="#cbd5e1"; bgcolor="#f8fafc"; margin=10;
    sa_alpha  [label="Alpha · P0", fillcolor="#2563eb", fontcolor="white"];
    sa_a      [label="A · P3/P7", fillcolor="#16a34a", fontcolor="white"];
    sa_b      [label="B · P5", fillcolor="#ea580c", fontcolor="white"];
    sa_omega  [label="Omega · P10", fillcolor="#7c3aed", fontcolor="white"];
    sa_lambda [label="Lambda · P11", fillcolor="#dc2626", fontcolor="white"];
  }

  // outputs
  subgraph cluster_out {
    label=<<b>Produit</b>>; fontsize=11; style="rounded"; color="#cbd5e1"; bgcolor="#f8fafc"; margin=10;
    node [fillcolor="#f1f5f9", color="#94a3b8", fontcolor="#1e293b"];
    o_commit [label="Commits Git\n(P4, par itération)"];
    o_mem    [label="memory/ : lessons/ + INDEX.md\n(P11, ACCEPTÉ uniquement)\n+ rebuild attention", shape=cylinder, fillcolor="#fde68a", color="#b45309", fontcolor="#78350f"];
    o_rep    [label="Rapport final utilisateur\n(traçabilité ACCEPTÉ/REJETÉ)"];
  }

  note [label="Briefs copiés VERBATIM depuis SKILL.md\n(pas reformulés ⇒ fidélité au design)\nNe lit jamais la mémoire pendant le run\n(Alpha en amont, Lambda en aval)",
        shape=note, fillcolor="#fef9c3", color="#ca8a04", fontcolor="#713f12", fontsize=9];

  user -> orch;
  orch -> sa_alpha  [label=" brief", style=dashed];
  orch -> sa_a      [style=dashed];
  orch -> sa_b      [style=dashed];
  orch -> sa_omega  [style=dashed];
  orch -> sa_lambda [style=dashed];
  orch -> o_commit;
  orch -> o_mem [label=" écrit", color="#b45309", fontcolor="#92400e"];
  orch -> o_rep;
  orch -> note [style=invis];
  { rank=same; orch; note; }
}
