digraph agent_a {
  rankdir=LR;
  bgcolor="white";
  fontname="DejaVu Sans";
  labelloc="t";
  fontsize=14;
  label=<<b>A — implementer</b>  ·  Phase 3 (iterable in Phase 7)<br/><font point-size="10">Implements the task per the brief, integrates Alpha recommendations + anti-pattern constraints</font>>;
  nodesep=0.28;
  ranksep=0.7;

  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", penwidth=1.2, margin="0.12,0.07"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b", penwidth=1.1];

  subgraph cluster_in {
    label=<<b>Input — enriched brief A</b>>; fontsize=11; style="rounded"; color="#cbd5e1"; bgcolor="#f8fafc"; margin=10;
    node [fillcolor="#f1f5f9", color="#94a3b8", fontcolor="#1e293b"];
    in_brief [label=<<font point-size="9">• Task description + success criteria (verbatim)<br align="left"/>• Alpha output verbatim (## RETRIEVED MEMORY)<br align="left"/>• Anti-pattern constraints (standard + Alpha)<br align="left"/>• Documents to read before coding<br align="left"/>• Files NOT to touch</font>>];
  }

  a [label=<<b>A</b><br/><font point-size="9">implements within the brief scope<br/>proactive fixes OK <i>if documented</i></font>>,
     fillcolor="#16a34a", fontcolor="white", penwidth=1.6];

  mandate [label="Mandate: code only\nNO commits (-> orchestrator P4)\nNO git ops (stash / clean / restore)\nre-launched in P7 (A2, A3...) if B finds GAP",
           shape=note, fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d", fontsize=9];

  subgraph cluster_out {
    label=<<b>Outputs</b>>; fontsize=11; style="rounded"; color="#cbd5e1"; bgcolor="#f8fafc"; margin=10;
    node [fillcolor="#dcfce7", color="#16a34a", fontcolor="#14532d"];
    out_code [label="Modified / created code\n(within scope)"];
    out_rep  [label=<<b>Report A</b><br align="left"/><font point-size="9">files modified · test results<br align="left"/>empirical measurements · surprises</font>>];
  }

  in_brief -> a [label=" brief"];
  a -> out_code;
  a -> out_rep [label=" -> commit P4 + Omega P10"];
  a -> mandate [style=invis];
  { rank=same; a; mandate; }
}
