digraph agent_b {
  rankdir=LR;
  bgcolor="white";
  fontname="DejaVu Sans";
  labelloc="t";
  fontsize=14;
  label=<<b>B — reviewer indépendant</b>  ·  Phase 5 (spawn frais à chaque itération)<br/><font point-size="10">Audite le code de A contre les critères, indépendamment des choix de design de A</font>>;
  nodesep=0.28;
  ranksep=0.7;

  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", penwidth=1.2, margin="0.12,0.07"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b", penwidth=1.1];

  subgraph cluster_in {
    label=<<b>Input — brief B</b>>; fontsize=11; style="rounded"; color="#cbd5e1"; bgcolor="#f8fafc"; margin=10;
    node [fillcolor="#f1f5f9", color="#94a3b8", fontcolor="#1e293b"];
    in_brief [label=<<font point-size="9">• Fichiers à reviewer = diff du commit P4<br align="left"/>• Critères de succès (verbatim utilisateur)<br align="left"/>• Grille d'audit (4 axes)<br align="left"/><b>• NE voit PAS le rapport de A</b> (anti-biais)</font>>];
  }

  b [label=<<b>B</b><br/><font point-size="9">Grille d'audit :<br/>1. sémantique préservée (pytest)<br/>2. anti-patterns<br/>3. critères user (PASS / FAIL)<br/>4. tests empiriques (lance benchs)</font>>,
     fillcolor="#ea580c", fontcolor="white", penwidth=1.6];

  mandate [label="Mandat : LECTURE SEULE\npeut LANCER tests / benchs\nno Write · no Edit · no git\nspawn frais ⇒ jugement indépendant",
           shape=note, fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d", fontsize=9];

  subgraph cluster_out {
    label=<<b>Output — verdict</b>>; fontsize=11; style="rounded"; color="#cbd5e1"; bgcolor="#f8fafc"; margin=10;
    node [fillcolor="#ffedd5", color="#ea580c", fontcolor="#7c2d12"];
    out_ok  [label=<<b>CONFORME</b><br align="left"/><font point-size="9">points marquants validés (3-5)<br align="left"/>+ recos non-bloquantes (opt.)</font>>, fillcolor="#dcfce7", color="#16a34a", fontcolor="#14532d"];
    out_ko  [label=<<b>ÉCART</b><br align="left"/><font point-size="9">liste numérotée d'écarts<br align="left"/>sévérité BLOQUANT / MAJEUR / MINEUR<br align="left"/>+ tests qui ont tourné</font>>, fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d"];
  }

  in_brief -> b [label=" diff + critères"];
  b -> out_ok [label=" → Phase 6"];
  b -> out_ko [label=" → Phase 6"];
  b -> mandate [style=invis];
  { rank=same; b; mandate; }
}
