digraph justdoit_overall {
  rankdir=TB;
  bgcolor="white";
  fontname="DejaVu Sans";
  labelloc="t";
  fontsize=15;
  label=<<b>/justdoit v2.3 — Pipeline 12 phases</b><br/><font point-size="11">Double-review A+B avec loop + apprentissage long-terme mémoire</font>>;
  nodesep=0.35;
  ranksep=0.45;

  node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", penwidth=1.3, margin="0.14,0.08"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b", penwidth=1.1];

  // ---------- Légende (couleur → agent) ----------
  subgraph cluster_legend {
    label=<<b>Agents</b>>;
    fontsize=11; style="rounded"; color="#cbd5e1"; margin=8;
    node [shape=box, style="filled", fontsize=9, margin="0.08,0.04", width=1.5, height=0.18];
    lg_orch  [label="Orchestrateur", fillcolor="#475569", fontcolor="white"];
    lg_alpha [label="Alpha", fillcolor="#2563eb", fontcolor="white"];
    lg_a     [label="A — implémenter", fillcolor="#16a34a", fontcolor="white"];
    lg_b     [label="B — reviewer", fillcolor="#ea580c", fontcolor="white"];
    lg_omega [label="Omega", fillcolor="#7c3aed", fontcolor="white"];
    lg_lambda[label="Lambda", fillcolor="#dc2626", fontcolor="white"];
    lg_orch -> lg_alpha -> lg_a -> lg_b -> lg_omega -> lg_lambda [style=invis];
  }

  // ---------- Acteurs / infra ----------
  user      [label="Utilisateur", shape=oval, fillcolor="#0f172a", fontcolor="white"];
  attention [label="Attention layer  (infra)\nquery.py · index.npz\nmulti-qa-mpnet · 768-d", shape=component, fillcolor="#ccfbf1", color="#0d9488", fontcolor="#134e4a"];
  memory    [label="Base mémoire\nepisodes/ · lessons/ · INDEX.md", shape=cylinder, fillcolor="#fde68a", color="#b45309", fontcolor="#78350f"];

  // ---------- Phases (couleur = agent responsable) ----------
  p0  [label="Phase 0 — Alpha\nretrieval mémoire", fillcolor="#2563eb", fontcolor="white"];
  p1  [label="Phase 1 — Orch.\nparser + brief A", fillcolor="#475569", fontcolor="white"];
  p2  [label="Phase 2 — Orch.\nTaskCreate", fillcolor="#475569", fontcolor="white"];
  p3  [label="Phase 3 — A\nimplémenter", fillcolor="#16a34a", fontcolor="white"];
  p4  [label="Phase 4 — Orch.\ncommit après A", fillcolor="#475569", fontcolor="white"];
  p5  [label="Phase 5 — B\nreviewer indépendant", fillcolor="#ea580c", fontcolor="white"];
  p6  [label="Phase 6 — Orch.\ndécision verdict B", shape=diamond, fillcolor="#475569", fontcolor="white", margin="0.05,0.02"];
  p7  [label="Phase 7 — A\nitération (A2, A3…)", fillcolor="#16a34a", fontcolor="white"];
  p8  [label="Phase 8 — Orch.\narbitrage (it ≥ max)", fillcolor="#475569", fontcolor="white"];
  p9  [label="Phase 9 — Orch.\nrétro orchestrateur", fillcolor="#475569", fontcolor="white"];
  p10 [label="Phase 10 — Omega\nsynthèse + propositions", fillcolor="#7c3aed", fontcolor="white"];
  p11 [label="Phase 11 — Lambda\nvalidation backlog", fillcolor="#dc2626", fontcolor="white"];

  // ---------- Flot principal ----------
  user -> p0 [label=" /justdoit <tâche>"];
  p0 -> p1 -> p2 -> p3 -> p4 -> p5 -> p6;
  p6 -> p7  [label=" ÉCART · it<max"];
  p6 -> p8  [label=" ÉCART · it≥max"];
  p6 -> p9  [label=" CONFORME"];
  p7 -> p4  [label=" re-commit →\n nouveau B (frais)", style=dashed, constraint=false, color="#ea580c", fontcolor="#c2410c"];
  p8 -> p9;
  p9 -> p10 -> p11;
  p11 -> user [label=" rapport final\n (ACCEPTÉ/REJETÉ)", style=dotted];

  // ---------- Câblage infra ----------
  attention -> p0 [label=" top-K cosine\n + override imp≥4", color="#0d9488", fontcolor="#0f766e"];
  memory    -> p0 [label=" lecture", color="#b45309", fontcolor="#92400e"];
  p10 -> memory   [label=" écrit épisode", color="#7c3aed", fontcolor="#6d28d9"];
  p11 -> memory   [label=" écrit leçons ACCEPTÉ\n + rebuild index", color="#dc2626", fontcolor="#b91c1c"];

  // hints de placement
  { rank=same; p0; attention; }
  { rank=same; lg_orch; user; }
}
