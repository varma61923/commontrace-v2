digraph agent_alpha {
  rankdir=LR;
  bgcolor="white";
  fontname="DejaVu Sans";
  labelloc="t";
  fontsize=14;
  label=<<b>Alpha — memory retrieval</b>  ·  Phase 0<br/><font point-size="10">Identifies relevant lessons/episodes for the incoming task (attention pre-filter + qualitative judgment)</font>>;
  nodesep=0.28;
  ranksep=0.7;

  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", penwidth=1.2, margin="0.12,0.07"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b", penwidth=1.1];

  // ---------- Inputs ----------
  subgraph cluster_in {
    label=<<b>Inputs</b>>; fontsize=11; style="rounded"; color="#cbd5e1"; bgcolor="#f8fafc"; margin=10;
    node [fillcolor="#f1f5f9", color="#94a3b8", fontcolor="#1e293b"];
    in_inv [label="/commontrace invocation\n(verbatim user)"];
    in_mem [label="memory/\n(read-only)", shape=cylinder, fillcolor="#fde68a", color="#b45309", fontcolor="#78350f"];
    in_att [label="Attention layer\nquery.py · index.npz", shape=component, fillcolor="#ccfbf1", color="#0d9488", fontcolor="#134e4a"];
  }

  // ---------- Agent (internal steps) ----------
  alpha [label=<<b>ALPHA</b><br/><font point-size="9">0. attention pre-filter (top-K cosine + override imp&gt;=4)<br/>1. read INDEX.md (filter by domain)<br/>2. select 3-7 candidates<br/>3-4. verify applies_when / do_not_apply_when<br/>5-6. sort by score = importance x tag_match</font>>,
         fillcolor="#2563eb", fontcolor="white", penwidth=1.6];

  // ---------- Mandate ----------
  mandate [label="Mandate: READ-ONLY\nno Write · no Edit · no git\nbest-effort -> NON-BLOCKING\n(failure => classical workflow)",
           shape=note, fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d", fontsize=9];

  // ---------- Output ----------
  subgraph cluster_out {
    label=<<b>Output</b>>; fontsize=11; style="rounded"; color="#cbd5e1"; bgcolor="#f8fafc"; margin=10;
    node [fillcolor="#dbeafe", color="#2563eb", fontcolor="#1e3a8a"];
    out [label=<<b>## RETRIEVED MEMORY (Alpha)</b><br align="left"/><font point-size="9">• Applicable lessons (3-5) — slug, importance, cosine,<br align="left"/>  why-applies-here, how-to-apply<br align="left"/>• Previous episodes (0-2)<br align="left"/>• Recommendations for brief A<br align="left"/>• Confidence: HIGH / MEDIUM / LOW / NONE<br align="left"/>• Lessons consulted (traceability)</font>>];
  }

  // ---------- Edges ----------
  in_att -> alpha [label=" top-K + imp>=4", color="#0d9488", fontcolor="#0f766e"];
  in_mem -> alpha [label=" read", color="#b45309", fontcolor="#92400e"];
  in_inv -> alpha [label=" task"];
  alpha -> out [label=" injected verbatim\n into brief A", penwidth=1.4];
  alpha -> mandate [style=invis];
  { rank=same; alpha; mandate; }
}
