digraph agent_lambda {
  rankdir=LR;
  bgcolor="white";
  fontname="DejaVu Sans";
  labelloc="t";
  fontsize=14;
  label=<<b>Lambda — automatic backlog validation</b>  ·  Phase 11<br/><font point-size="10">Independent reviewer of Omega proposals — the memory backlog equivalent of the B reviewer for code</font>>;
  nodesep=0.28;
  ranksep=0.7;

  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", penwidth=1.2, margin="0.12,0.07"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b", penwidth=1.1];

  subgraph cluster_in {
    label=<<b>Inputs</b>>; fontsize=11; style="rounded"; color="#cbd5e1"; bgcolor="#f8fafc"; margin=10;
    node [fillcolor="#f1f5f9", color="#94a3b8", fontcolor="#1e293b"];
    in_omega [label="## OMEGA OUTPUT\n(proposals from the run)"];
    in_mem   [label="memory/ (read-only)\nexisting lessons · INDEX.md", shape=cylinder, fillcolor="#fde68a", color="#b45309", fontcolor="#78350f"];
    in_rub   [label="Importance rubric 1-5\n(recalled verbatim)"];
  }

  lambda [label=<<b>LAMBDA</b><br/><font point-size="9">audit per proposal · 4 criteria:<br/>1. formal quality (YAML, applies/do_not)<br/>2. non-duplication (semantic matching)<br/>3. generalization (>= 3 contexts beyond project)<br/>4. importance calibration (vs rubric)</font>>,
          fillcolor="#dc2626", fontcolor="white", penwidth=1.6];

  mandate [label="Mandate: READ-ONLY\nno Write · no Edit · no git\n=> orchestrator applies ACCEPTED\n   (write lessons/ + rebuild attention)\nfresh spawn each run",
           shape=note, fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d", fontsize=9];

  subgraph cluster_out {
    label=<<b>Output</b>>; fontsize=11; style="rounded"; color="#cbd5e1"; bgcolor="#f8fafc"; margin=10;
    node [fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d"];
    out [label=<<b>## LAMBDA OUTPUT</b><br align="left"/><font point-size="9">per proposal: <b>ACCEPTED</b> / <b>REJECTED</b> / <b>NEEDS REFINEMENT</b><br align="left"/>+ justification (2-3 sentences)<br align="left"/>+ summary (total / accepted / rejected / refine)</font>>];
  }

  in_omega -> lambda [label=" proposals"];
  in_mem   -> lambda [label=" non-duplication", color="#b45309", fontcolor="#92400e"];
  in_rub   -> lambda;
  lambda -> out [label=" -> orchestrator applies\n ACCEPTED only", penwidth=1.4];
  lambda -> mandate [style=invis];
  { rank=same; lambda; mandate; }
}
