# CommonTrace Hub server configuration. Copy to hub/.env (or export these
# in your process manager / container) and fill in real values. This file
# documents every HUB_-prefixed env var hub/config.py reads -- there are no
# others, and there is no code path that falls back to a hardcoded secret.
#
# hub/.env is (and must stay) gitignored once it holds real values.

# --- Required ---------------------------------------------------------
# Async SQLAlchemy URL. Must use the asyncpg driver.
HUB_DATABASE_URL=postgresql+asyncpg://commontrace:CHANGE_ME@localhost:5432/commontrace_hub

# --- Transport ----------------------------------------------------------
HUB_HOST=127.0.0.1
HUB_PORT=8420
HUB_STREAMABLE_HTTP_PATH=/mcp

# --- Transport safety -----------------------------------------------------
# The Hub refuses to start bound to a non-loopback HUB_HOST (this speaks
# plain HTTP; API keys travel as a Bearer token) unless this is set -- a
# deliberate acknowledgment that a TLS-terminating proxy is in front, not a
# guess the Hub makes about your network. Leave unset/false for a bare
# loopback-bound Hub (the default above); set true only once you've put a
# proxy in front and are intentionally binding HUB_HOST to something a proxy
# or container/pod network can reach.
# HUB_ALLOW_INSECURE_HTTP=false

# --- Cross-org commons ----------------------------------------------------
# true (default) matches every existing deployment's current behavior.
# Set to false to remove share_trace, unshare_trace, and commons_overlap
# from the MCP tool surface entirely -- not merely unused, but absent, so
# "no cross-org sharing" holds even if every org on this deployment forgets
# the feature exists. Use this for an internal-only deployment with no
# other org's data to compare against. account_usage is unaffected either
# way: it reports an org's own plan and usage, never another org's data.
# HUB_COMMONS_ENABLED=true

# --- Operator console (hub/admin.py) --------------------------------------
# UNSET (the default) means the /admin routes are never registered: a
# deployment that has not opted in has no console to probe, and an
# unauthenticated request gets a 404 from the router rather than a 401 from
# a handler.
#
# When set, this is the password half of an HTTP Basic credential (the
# username is ignored), compared in constant time. It is a SHARED OPERATOR
# SECRET, not a per-user login -- keep it in a secret store next to
# HUB_DATABASE_URL, and rotate it by changing this value and restarting.
#
# The console is READ-ONLY by design. It renders state and shows the CLI
# command for anything that changes state, so a hijacked browser session
# cannot wipe a tenant or mint a key. See hub/admin.py for the reasoning.
# HUB_ADMIN_TOKEN=

# The org that accepted Knowledge Base proposals are PUBLISHED UNDER -- never
# the submitting org, so what other orgs read is operator-curated substrate
# knowledge rather than a customer's record. Unset means the console can
# still review and decline, but its accept action fails closed and shows the
# CLI command: putting a customer's id on Knowledge Base content is the one
# mistake this boundary exists to prevent.
# HUB_OPERATOR_ORG_ID=

# --- API key verification fast path (hub/auth.py) --------------------------
#
# Peppers the HMAC-SHA256 digest used to verify API keys in ~1ms via an
# indexed lookup, instead of the Argon2id computation the product used for
# every authenticated request (measured: ~83ms and 64MiB of transient RAM
# per verification -- the Hub's binding throughput ceiling before this
# existed). Keep it IDENTICAL across every replica and every restart of one
# deployment, or a given key's fast-path digest only matches on whichever
# replica most recently saw and backfilled it.
#
# Unset is safe, not insecure: a random pepper is generated per process
# instead, so verification is still correct, just slower for a key whose
# digest was computed under a DIFFERENT process's ephemeral pepper (it
# falls through to the original Argon2 path, unchanged, and re-backfills).
# Set this once you have more than one replica, or want the fast path's
# benefit to survive a restart.
#
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it does not break anything: every key falls back to Argon2 once
# and re-backfills under the new pepper on its next use.
# HUB_API_KEY_PEPPER=

# --- Human user sign-in: OIDC bearer JWTs (hub/sso.py, hub/rbac.py) --------
#
# API keys (above) authenticate a WORKLOAD -- a CI job, an agent fleet.
# These authenticate a PERSON, previously created with
# `hub.manage create-user` and linked to their identity provider with
# `hub.manage link-sso`. Leaving HUB_OIDC_ISSUER/HUB_OIDC_AUDIENCE unset
# (the default) disables this entirely: every JWT-shaped bearer token is
# refused before it reaches the database, and only API keys work, exactly
# as before this existed.
#
# The issuer your identity provider puts in a token's `iss` claim.
# HUB_OIDC_ISSUER=https://your-idp.example.com/
#
# The audience your identity provider puts in a token's `aud` claim --
# usually a client id you registered with it for this Hub.
# HUB_OIDC_AUDIENCE=commontrace-hub
#
# Exactly one of the next two is required once the above are set.
#
# A static JWKS document (the JSON your IdP's /.well-known/jwks.json
# serves), for an IdP that does not rotate signing keys or for a fixed
# test fixture. Takes priority over HUB_OIDC_JWKS_URI if both are set.
# HUB_OIDC_JWKS={"keys": [...]}
#
# The URL to fetch a JWKS document from -- fetched over HTTPS and cached
# for one hour, so a key rotation on the IdP side is picked up without a
# restart. Use this for a real IdP.
# HUB_OIDC_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
#
# Only asymmetric algorithms (RS256/RS384/RS512/ES256/ES384/ES512) are
# ever accepted for verification, regardless of what a token's own header
# claims -- HS256 and "none" are refused outright. This is not
# configurable: it closes the algorithm-confusion attack where a token is
# HMAC-signed using the issuer's own public RSA key as the secret.

# --- Customer console (hub/console.py) --------------------------------------
#
# Signing secret for the CUSTOMER console's session cookies, served at /app.
# This is the surface your customers see: their own fleet, their own memory,
# and the causal report with its validity verdict rendered above the effect
# sizes. Scoped to one organisation by a signed session and READ-ONLY -- it
# cannot change any state at all, which is why it carries no CSRF token.
#
# Unset disables it entirely: no /app route is registered, so a deployment
# that has not opted in has nothing to probe.
#
# SEPARATE from HUB_ADMIN_TOKEN on purpose. That token is your operator
# credential; this one signs customer sessions. One value doing both means
# one leak compromises both surfaces at once.
#
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs every customer out, which is the intended emergency stop.
# HUB_CONSOLE_SECRET=

# --- Self-serve signup (hub/signup.py) -------------------------------------
# false (default): no /signup route is registered -- the only way to create
# an org is still `python -m hub.manage create-org`, run by an operator.
# Set true to let a visitor create their own free-plan org and first API
# key with nobody involved. There is NO email verification behind this
# (this Hub has no outbound email integration): the free plan's own limits
# (hub/plans.py) are the blast radius bound for an uncontactable or
# fraudulent signup either way. A tight per-address rate limit and a
# honeypot field are the only abuse controls -- there is no CAPTCHA.
# HUB_SIGNUP_ENABLED=false

# --- Self-serve billing (hub/billing.py) -----------------------------------
# Empty (default): the console's "Upgrade" buttons render nothing and
# /billing/webhook is never registered. Fill in all four to let a
# signed-in org upgrade itself to a paid plan via Stripe Checkout, and to
# keep this Hub's own Organization.plan in sync with what Stripe actually
# charged, via a webhook Stripe calls (never something this Hub polls for).
#
# HUB_STRIPE_WEBHOOK_SECRET is not optional even though checkout itself
# does not call it directly: the "Upgrade" button stays hidden until it is
# set, alongside the key and a price. Offering Checkout without a working
# webhook would let a customer complete a real Stripe payment that this
# Hub then has no route left to ever learn about -- Organization.plan
# would never move off "free". Charged and never upgraded is worse than
# the button not existing, so this Hub refuses the partial configuration
# rather than degrading into it.
#
# The key that authenticates THIS DEPLOYMENT to Stripe's API. Keep it in a
# secret store next to HUB_DATABASE_URL.
# HUB_STRIPE_SECRET_KEY=
#
# The signing secret Stripe's dashboard shows for the webhook endpoint you
# register there, pointed at https://<this-hub>/billing/webhook. Required
# for the webhook route to verify a delivery actually came from Stripe --
# without it, an unauthenticated POST could forge a plan upgrade for any
# org_id, so /billing/webhook is not registered at all until this is set.
# HUB_STRIPE_WEBHOOK_SECRET=
#
# Stripe Price ids (from the Stripe dashboard, "price_...") for the two
# billable plans (hub/plans.py:BILLABLE_PLANS). Either may be left unset if
# this deployment only sells one paid tier.
# HUB_STRIPE_PRICE_TEAM=
# HUB_STRIPE_PRICE_SCALE=

# --- Tenant isolation: row-level security ---------------------------------
# Postgres skips EVERY row-level-security policy for a superuser or a role
# holding BYPASSRLS -- silently, no error, no log line. The dangerous state
# is therefore not "RLS missing" but "RLS installed, listed by pg_policies,
# passing an audit, and doing nothing".
#
# Unset/false (default): the Hub REFUSES TO START when it positively finds
# that state (policies exist AND the connecting role bypasses them). Point
# HUB_DATABASE_URL at a role that owns nothing, is NOSUPERUSER and
# NOBYPASSRLS, and holds only DML grants -- docker-compose.yml ships one
# (`commontrace_app`, created by hub/postgres-init/10-runtime-role.sql).
#
# Set true ONLY to acknowledge a deployment that intentionally serves as an
# owner/superuser role, accepting that tenant isolation then rests entirely
# on hub/crud.py's own org_id predicates with no database-enforced backstop.
# HUB_ALLOW_RLS_BYPASS=false
#
# The stronger, opt-in form: refuse to start unless RLS is affirmatively
# enforced, so a database that never ran the migration -- or one somebody
# dropped the policies from -- is refused too, instead of passing merely by
# having nothing to bypass.
# HUB_REQUIRE_RLS=false

# --- Value ledger signing (hub/crud.py value_delivered) --------------------
# Empty (default): value_delivered's `ledger` is hash-chained (internally
# consistent -- editing, dropping, or reordering a line breaks the chain,
# and commontrace.value.verify_ledger proves it) but NOT signed. Its genesis
# and algorithm are both public by design, so anyone with write access to
# wherever a ledger ends up stored could fabricate an entire replacement
# chain that verifies just as cleanly as a real one -- a hash chain alone
# only catches editing an EXISTING ledger, not being handed a fabricated one
# wholesale. Set this to also sign every ledger with HMAC-SHA256 under this
# key, checkable with commontrace.value.verify_ledger_signature, so a
# signature only validates for a chain this deployment actually issued.
#
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it in a secret store next to HUB_DATABASE_URL, and set it IDENTICALLY
# across every replica -- unlike HUB_API_KEY_PEPPER, a value ledger is meant
# to be verified by the customer LATER against whichever replica happened to
# sign it, so a key that varies by process would make some invoices verify
# and others not for no visible reason. There is no key versioning here: a
# rotation invalidates verification of already-issued invoices unless you
# keep the retired key available out-of-band to still check against.
# Also derives every webhook endpoint's signing secret (hub/events.py), so
# rotating this invalidates both past ledger signatures AND every configured
# webhook at once -- see DEPLOYMENT.md before you change it.
# HUB_LEDGER_SIGNING_KEY=

# --- Abuse controls (contribute_trace) -----------------------------------
HUB_MAX_TITLE_CHARS=500
HUB_MAX_TEXT_CHARS=20000
HUB_MAX_TAGS=20
HUB_MAX_TAG_CHARS=64
HUB_MAX_TRACE_BYTES=65536
# Per-org write limit (contribute_trace/amend_trace/submit_kb_entry).
# Raised from 20/min burst 5, which could not serve this product's own
# documented onboarding: `commontrace import` a fleet's history, then
# `commontrace sync --push-traces`. At 20/min a 46-trace store took over
# two minutes and a 1,000-trace import the better part of an hour.
# Two writes per second per org still protects the shared Postgres and
# still bounds a runaway agent to a rate an operator notices quickly.
# Refusals now carry `Retry-After`, and the CLI paces itself against it.
HUB_RATE_LIMIT_PER_MINUTE=120
HUB_RATE_LIMIT_BURST=30
HUB_SUSPECT_URL_THRESHOLD=5

# Every numeric setting in this file is range-checked at startup: an
# out-of-range value (HUB_PORT=99999, HUB_DB_POOL_SIZE=-1) refuses to start
# and names the variable and the bound, rather than starting and then
# failing later somewhere that names neither.

# --- Rate limiting: every authenticated request, and auth itself ----------
# HUB_RATE_LIMIT_PER_MINUTE/BURST above only gate contribute_trace/
# amend_trace. These two apply more broadly:
# read: every authenticated MCP tool call (search_traces, get_trace,
#   vote_trace, list_tags, commons_overlap, account_usage), keyed by org.
# auth attempts: checked before verification runs at all, keyed by client
#   address -- bounds CPU spent on the legacy Argon2 fallback path (most
#   requests resolve via an indexed HMAC lookup instead; see
#   HUB_API_KEY_PEPPER above).
HUB_READ_RATE_LIMIT_PER_MINUTE=300
HUB_READ_RATE_LIMIT_BURST=60
HUB_AUTH_ATTEMPTS_PER_MINUTE=60
HUB_AUTH_ATTEMPTS_BURST=20
# /readyz executes a real SELECT 1 and is necessarily unauthenticated
# (an orchestrator's prober carries no API key), so it has its own limiter.
HUB_READYZ_RATE_LIMIT_PER_MINUTE=120
HUB_READYZ_RATE_LIMIT_BURST=30

# Every client-address-keyed limiter above defaults to trusting only the raw
# TCP peer address (request.client.host) -- correct with no proxy in front,
# but that address is the PROXY's own address for every request behind any
# reverse proxy or load balancer (including the loopback + sidecar TLS
# proxy shape this Hub documents as supported), collapsing every limiter
# above into one shared bucket across every real client. Set this to the
# exact number of trusted reverse proxies in front of this Hub (usually 1)
# to resolve the client address from X-Forwarded-For instead -- specifically
# the value that many positions from the RIGHT of the header, which is the
# one entry a trusted proxy (not an upstream client) is responsible for
# appending. Leave at 0 unless you have verified your proxy topology:
# setting it with no such proxy in front lets any client forge its own
# rate-limit identity via a spoofed X-Forwarded-For header.
HUB_TRUSTED_PROXY_HOPS=0

# --- Connection pool ------------------------------------------------------
# NOTE: pool size is PER REPLICA. HUB_DB_POOL_SIZE * replicas must stay under
# your Postgres max_connections, or a rolling deploy exhausts connections
# while old and new replicas overlap. See hub/DEPLOYMENT.md §2.
HUB_DB_POOL_SIZE=10
HUB_DB_MAX_OVERFLOW=5
HUB_DB_POOL_TIMEOUT=30
HUB_DB_POOL_RECYCLE=1800

# --- Overload behaviour ---------------------------------------------------
# What one replica does when it is asked for more than it can serve.
# hub/bench_concurrency.py measured the default without these: at 128
# concurrent clients p99 reached 1.3s against an EMPTY handler, throughput
# was flat from 8 clients up, and nothing anywhere bounded the queue. With
# a slow database, requests pile onto the pool above until they all fail
# together -- degradation is invisible until it is total.
#
# Postgres-side ceiling on any single query, in milliseconds. Also bounds a
# query whose caller already gave up, which is the case no application-side
# timeout can reach. 0 leaves your database role's own setting alone.
HUB_DB_STATEMENT_TIMEOUT_MS=30000
# Application-side ceiling on one request, in seconds. Deliberately longer
# than HUB_DB_POOL_TIMEOUT + the statement timeout, so a request that is
# merely slow for a legitimate reason is killed by the specific bound that
# should have caught it rather than by this one. 0 disables it.
HUB_REQUEST_TIMEOUT_SECONDS=60
# In-flight requests per replica before further ones are refused outright
# with 503 + Retry-After, rather than queued. Refusing fast is kinder than
# queueing: the caller learns immediately and can back off, and requests
# already admitted keep the latency they were promised instead of everyone
# degrading together. 0 disables the cap -- for a deployment that sheds at
# its edge proxy and does not want two layers disagreeing about which one
# refused a request.
HUB_MAX_CONCURRENT_REQUESTS=512

# --- Lifecycle ------------------------------------------------------------
# How long to let in-flight requests finish on SIGTERM before forcing exit.
HUB_GRACEFUL_SHUTDOWN_SECONDS=30

# --- Misc -----------------------------------------------------------------
# Logs are emitted as one JSON object per line on stdout.
HUB_LOG_LEVEL=INFO

# --- Testing only (not read by hub/config.py; read by hub/tests/conftest.py) ---
# HUB_TEST_DATABASE_URL=postgresql+asyncpg://commontrace:CHANGE_ME@localhost:5432/commontrace_hub_test

# --- Client side (commontrace CLI, not the server -- see commontrace/hub_client.py) ---
# COMMONTRACE_HUB_URL=http://localhost:8420/mcp
# COMMONTRACE_HUB_API_KEY=ct_live_...   # issued via `python -m hub.manage issue-key <org_id>`
