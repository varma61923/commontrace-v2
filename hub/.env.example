# CommonTrace Hub server configuration. Copy to hub/.env (or export these
# in your process manager / container) and fill in real values. This file
# documents every HUB_-prefixed env var hub/config.py reads -- there are no
# others, and there is no code path that falls back to a hardcoded secret.
#
# hub/.env is (and must stay) gitignored once it holds real values.

# --- Required ---------------------------------------------------------
# Async SQLAlchemy URL. Must use the asyncpg driver.
HUB_DATABASE_URL=postgresql+asyncpg://commontrace:CHANGE_ME@localhost:5432/commontrace_hub

# --- Transport ----------------------------------------------------------
HUB_HOST=127.0.0.1
HUB_PORT=8420
HUB_STREAMABLE_HTTP_PATH=/mcp

# --- Transport safety -----------------------------------------------------
# The Hub refuses to start bound to a non-loopback HUB_HOST (this speaks
# plain HTTP; API keys travel as a Bearer token) unless this is set -- a
# deliberate acknowledgment that a TLS-terminating proxy is in front, not a
# guess the Hub makes about your network. Leave unset/false for a bare
# loopback-bound Hub (the default above); set true only once you've put a
# proxy in front and are intentionally binding HUB_HOST to something a proxy
# or container/pod network can reach.
# HUB_ALLOW_INSECURE_HTTP=false

# --- Cross-org commons ----------------------------------------------------
# true (default) matches every existing deployment's current behavior.
# Set to false to remove share_trace, unshare_trace, and commons_overlap
# from the MCP tool surface entirely -- not merely unused, but absent, so
# "no cross-org sharing" holds even if every org on this deployment forgets
# the feature exists. Use this for an internal-only deployment with no
# other org's data to compare against. account_usage is unaffected either
# way: it reports an org's own plan and usage, never another org's data.
# HUB_COMMONS_ENABLED=true

# --- Abuse controls (contribute_trace) -----------------------------------
HUB_MAX_TITLE_CHARS=500
HUB_MAX_TEXT_CHARS=20000
HUB_MAX_TAGS=20
HUB_MAX_TAG_CHARS=64
HUB_MAX_TRACE_BYTES=65536
# Per-org write limit (contribute_trace/amend_trace/submit_kb_entry).
# Raised from 20/min burst 5, which could not serve this product's own
# documented onboarding: `commontrace import` a fleet's history, then
# `commontrace sync --push-traces`. At 20/min a 46-trace store took over
# two minutes and a 1,000-trace import the better part of an hour.
# Two writes per second per org still protects the shared Postgres and
# still bounds a runaway agent to a rate an operator notices quickly.
# Refusals now carry `Retry-After`, and the CLI paces itself against it.
HUB_RATE_LIMIT_PER_MINUTE=120
HUB_RATE_LIMIT_BURST=30
HUB_SUSPECT_URL_THRESHOLD=5

# Every numeric setting in this file is range-checked at startup: an
# out-of-range value (HUB_PORT=99999, HUB_DB_POOL_SIZE=-1) refuses to start
# and names the variable and the bound, rather than starting and then
# failing later somewhere that names neither.

# --- Rate limiting: every authenticated request, and auth itself ----------
# HUB_RATE_LIMIT_PER_MINUTE/BURST above only gate contribute_trace/
# amend_trace. These two apply more broadly:
# read: every authenticated MCP tool call (search_traces, get_trace,
#   vote_trace, list_tags, commons_overlap, account_usage), keyed by org.
# auth attempts: checked before Argon2 verification runs at all, keyed by
#   client address -- bounds CPU spent verifying credentials from one source.
HUB_READ_RATE_LIMIT_PER_MINUTE=300
HUB_READ_RATE_LIMIT_BURST=60
HUB_AUTH_ATTEMPTS_PER_MINUTE=60
HUB_AUTH_ATTEMPTS_BURST=20
# /readyz executes a real SELECT 1 and is necessarily unauthenticated
# (an orchestrator's prober carries no API key), so it has its own limiter.
HUB_READYZ_RATE_LIMIT_PER_MINUTE=120
HUB_READYZ_RATE_LIMIT_BURST=30

# Every client-address-keyed limiter above defaults to trusting only the raw
# TCP peer address (request.client.host) -- correct with no proxy in front,
# but that address is the PROXY's own address for every request behind any
# reverse proxy or load balancer (including the loopback + sidecar TLS
# proxy shape this Hub documents as supported), collapsing every limiter
# above into one shared bucket across every real client. Set this to the
# exact number of trusted reverse proxies in front of this Hub (usually 1)
# to resolve the client address from X-Forwarded-For instead -- specifically
# the value that many positions from the RIGHT of the header, which is the
# one entry a trusted proxy (not an upstream client) is responsible for
# appending. Leave at 0 unless you have verified your proxy topology:
# setting it with no such proxy in front lets any client forge its own
# rate-limit identity via a spoofed X-Forwarded-For header.
HUB_TRUSTED_PROXY_HOPS=0

# --- Connection pool ------------------------------------------------------
# NOTE: pool size is PER REPLICA. HUB_DB_POOL_SIZE * replicas must stay under
# your Postgres max_connections, or a rolling deploy exhausts connections
# while old and new replicas overlap. See hub/DEPLOYMENT.md §2.
HUB_DB_POOL_SIZE=10
HUB_DB_MAX_OVERFLOW=5
HUB_DB_POOL_TIMEOUT=30
HUB_DB_POOL_RECYCLE=1800

# --- Lifecycle ------------------------------------------------------------
# How long to let in-flight requests finish on SIGTERM before forcing exit.
HUB_GRACEFUL_SHUTDOWN_SECONDS=30

# --- Misc -----------------------------------------------------------------
# Logs are emitted as one JSON object per line on stdout.
HUB_LOG_LEVEL=INFO

# --- Testing only (not read by hub/config.py; read by hub/tests/conftest.py) ---
# HUB_TEST_DATABASE_URL=postgresql+asyncpg://commontrace:CHANGE_ME@localhost:5432/commontrace_hub_test

# --- Client side (commontrace CLI, not the server -- see commontrace/hub_client.py) ---
# COMMONTRACE_HUB_URL=http://localhost:8420/mcp
# COMMONTRACE_HUB_API_KEY=ct_live_...   # issued via `python -m hub.manage issue-key <org_id>`
