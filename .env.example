# commontrace-v2 — environment variable template
#
# Copy to .env and fill in real values, OR export these directly in your shell.
# .env is already covered by .gitignore — never commit a filled-in copy.
#
# This lists the variables most deployments set. The complete, source-derived
# inventory (every variable the code reads, with file and line) is generated in
# docs/environment.md; the Hub server's own settings are in hub/README.md and
# hub/config.py. Every secret below also accepts a *_FILE variant pointing at a
# file (for Docker/Kubernetes secrets), e.g. COMMONTRACE_HUB_API_KEY_FILE.

# --------------------------------------------------------------------------
# Path resolution (optional — everything auto-detects without these)
# --------------------------------------------------------------------------

# Root of the commontrace installation. Only needed if a script is run from a
# location other than inside the checkout/install directory it should operate
# on (e.g. a cron job, a symlinked script). See README.md "Configuration".
# COMMONTRACE_ROOT=/opt/commontrace

# Legacy alias for COMMONTRACE_ROOT, kept for backward compatibility with
# pre-rename (justdoit) installs. Prefer COMMONTRACE_ROOT for new setups.
# JUSTDOIT_ROOT=/opt/commontrace

# --------------------------------------------------------------------------
# Air-gapped operation
# --------------------------------------------------------------------------

# Refuse every non-loopback network call (hosted LLMs, connectors, crawling,
# Hub sync) and load models from the local cache only. Same as
# `commontrace --offline <command>`.
# COMMONTRACE_OFFLINE=1

# --------------------------------------------------------------------------
# Hub client (`commontrace sync`, MCP Hub tools)
# --------------------------------------------------------------------------

# COMMONTRACE_HUB_URL=https://hub.example.com/mcp
# COMMONTRACE_HUB_API_KEY=

# --------------------------------------------------------------------------
# Optional model provider (drafting, extraction, answers). Core retrieval,
# capture and measurement never need one.
# --------------------------------------------------------------------------

# COMMONTRACE_LLM_PROVIDER=anthropic   # anthropic | openai | bedrock | vertex | ollama | ...
# COMMONTRACE_LLM_MODEL=
# COMMONTRACE_LLM_API_KEY=
# COMMONTRACE_LLM_BASE_URL=

# --------------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------------

# COMMONTRACE_LOG_FORMAT=json
# COMMONTRACE_LOG_FILE=/var/log/commontrace/commontrace.log
# COMMONTRACE_OTEL=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
