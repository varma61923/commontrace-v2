# unimem — environment variable template
#
# Copy to .env and fill in real values, OR export these directly in your shell.
# .env is already covered by .gitignore — never commit a filled-in copy.
#
# This lists the variables most deployments set. The complete, source-derived
# settings are defined in unimem/configuration.py and its JSON schema;
# the Hub server's settings are in hub/config.py. Every secret below also
# accepts a *_FILE variant pointing at a
# file (for Docker/Kubernetes secrets), e.g. UNIMEM_HUB_API_KEY_FILE.
# `docker compose --profile local up` reads .env into the local gateway and MCP
# containers when it exists.

# --------------------------------------------------------------------------
# Path resolution (optional — everything auto-detects without these)
# --------------------------------------------------------------------------

# Root of the unimem installation. Only needed if a script is run from a
# location other than inside the checkout/install directory it should operate
# on (e.g. a cron job, a symlinked script). See README.md "Configuration".
# UNIMEM_ROOT=/opt/unimem

# Legacy alias for UNIMEM_ROOT, kept for backward compatibility with
# pre-rename (justdoit) installs. Prefer UNIMEM_ROOT for new setups.
# JUSTDOIT_ROOT=/opt/unimem

# --------------------------------------------------------------------------
# Air-gapped operation
# --------------------------------------------------------------------------

# Refuse every non-loopback network call (hosted LLMs, connectors, crawling,
# Hub sync) and load models from the local cache only. Same as
# `unimem --offline <command>`.
# UNIMEM_OFFLINE=1

# --------------------------------------------------------------------------
# Hub client (`unimem sync`, MCP Hub tools)
# --------------------------------------------------------------------------

# UNIMEM_HUB_URL=https://hub.example.com/mcp
# UNIMEM_HUB_API_KEY=

# --------------------------------------------------------------------------
# Optional model provider (drafting, extraction, answers). Core retrieval,
# capture and measurement never need one.
# --------------------------------------------------------------------------

# UNIMEM_LLM_PROVIDER=anthropic   # anthropic | openai | bedrock | vertex | ollama | ...
# UNIMEM_LLM_MODEL=
# UNIMEM_LLM_API_KEY=
# UNIMEM_LLM_BASE_URL=

# --------------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------------

# UNIMEM_LOG_FORMAT=json
# UNIMEM_LOG_FILE=/var/log/unimem/unimem.log
# UNIMEM_OTEL=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
