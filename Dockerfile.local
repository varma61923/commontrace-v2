# The local UniMem runtime: CLI, gateway + console, and the MCP server over
# streamable HTTP, on one store volume. The Hub image (Dockerfile) is separate and
# deliberately ships only the client modules the server imports.
#
#   docker compose --profile local up        # gateway on :8787, MCP on :8421
#   docker run --rm -v unimem:/data unimem-local query "release checklist"

FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=30 \
    PIP_RETRIES=3

WORKDIR /build
COPY pyproject.toml README.md LICENSE ./
COPY unimem/ ./unimem/
COPY protocol/ ./protocol/
RUN pip install --prefix=/install ".[serve,security]"

FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS runtime

# Apply fixes newer than the pinned base image (PCRE2 and OpenSSL).
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade \
        libpcre2-8-0 libssl3t64 openssl openssl-provider-legacy \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UNIMEM_ROOT=/data

COPY --from=builder /install /usr/local
RUN useradd --create-home --uid 10001 unimem \
    && mkdir -p /data && chown unimem:unimem /data
COPY deploy/docker/local-entrypoint.sh /usr/local/bin/unimem-entrypoint
RUN chmod 0755 /usr/local/bin/unimem-entrypoint

USER unimem
WORKDIR /data
VOLUME ["/data"]
EXPOSE 8787 8421

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; \
sys.exit(0) if urllib.request.urlopen('http://127.0.0.1:8787/v1/health/live', timeout=2).status == 200 else sys.exit(1)"

ENTRYPOINT ["unimem-entrypoint"]
CMD ["gateway", "--host", "0.0.0.0", "--port", "8787"]
